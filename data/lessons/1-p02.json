     "code": "A = x/y",
     "md": "Define A con =.",
     "run": true
    },
    {
     "code": "B := x/y",
     "md": "Define B con := (no da salida).",
     "run": true
    },
    {
     "code": "x = 4.36;",
     "md": "Cambia x.",
     "run": true
    },
    {
     "code": "{A, B}",
     "md": "Mira las dos.",
     "run": true,
     "hint": "A guardó el número viejo; B se recalcula con el x nuevo."
    }
   ],
   "recall": {
    "prompt": "Sin mirar: x = 5.12, y = 4.37; A con =, B con :=, ambas x/y; x = 4.36; muestra {A, B}.",
    "hints": [
     "`A = x/y` y `B := x/y`.",
     "Después `x = 4.36;` y por último `{A, B}`.",
     "`x = 5.12; y = 4.37;`, `A = x/y;`, `B := x/y`, `x = 4.36;`, `{A, B}`"
