  {
   "type": "build",
   "section": "Clear: borrar variables",
   "title": "Clear: quitar un valor",
   "md": "Una variable guarda su valor hasta que la borras.",
   "more": "Los valores olvidados son la causa más habitual de resultados raros. Si una expresión con letras devuelve un número, sospecha de una variable con valor.",
   "target": "x^2 + 2 x",
   "parts": [
    {
     "code": "x = 3;",
     "md": "Dale un valor a x y olvídate de él.",
     "run": true
    },
    {
     "code": "x^2 + 2 x",
     "md": "Escribe un polinomio en x.",
     "run": true,
     "hint": "Sale un número: x valía 3."
    },
    {
     "code": "Clear[x]",
     "md": "Borra el valor de x.",
     "run": true
    },
    {
     "code": "x^2 + 2 x",
     "md": "El mismo polinomio, otra vez.",
     "run": true
    }
   ],
   "recall": {
    "prompt": "Sin mirar, en tres líneas: `x = 3;`, borra x y escribe `x^2 + 2 x`.",
    "hints": [
     "La segunda línea es `Clear[x]`.",
     "`x = 3;`, `Clear[x]` y `x^2 + 2 x`"
    ],
    "solution": "x = 3;\nClear[x]\nx^2 + 2 x",
    "check": {
     "type": "all",
     "checks": [
      {
       "type": "satisfies",
       "test": "Head[x] === Symbol",
       "msg": "`x` sigue teniendo valor: falta `Clear[x]`."
      },
      {
       "type": "expr",
       "expected": "x^2 + 2 x"
      }
     ]
    }
   },
   "cmds": [
    "Clear",
    "Set"
   ]
  },
  {
